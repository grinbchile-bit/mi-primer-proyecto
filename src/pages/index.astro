---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

const { data: providers, error } = await supabase.from('providers').select('*');

if (error) {
  console.error('Error al cargar servicios de Supabase:', error);
}

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
const serviceCount = providers?.length ?? 0;
---

<Layout title="RedRural — Los Muermos">
  <!-- Carga de Leaflet CSS en el head -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

  <div class="app-layout">
    <!-- PANEL LATERAL / BOTTOM SHEET EN MÓVIL -->
    <aside class="sidebar half" id="bottomSheet">
      <div class="sheet-handle-area" id="sheetHandle">
        <div class="sheet-handle" aria-hidden="true"></div>
      </div>

      <header class="brand-bar">
        <div class="brand">
          <div class="mark">R</div>
          <div>
            <h1>RedRural</h1>
            <p>Los Muermos · {serviceCount} {serviceCount === 1 ? 'servicio' : 'servicios'}</p>
          </div>
        </div>
      </header>

      <div class="search-wrap">
        <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" />
          <path d="M20 20l-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <input type="text" id="searchInput" placeholder="¿Qué necesitas? Leña, flete, miel..." autocomplete="off" />
      </div>

      <div class="chips" id="categoryFilters" role="tablist">
        <button class="chip active" data-category="todos" type="button">Todos</button>
        <button class="chip" data-category="🪚" type="button">Oficios</button>
        <button class="chip" data-category="🍯" type="button">Productos</button>
        <button class="chip" data-category="🥾" type="button">Turismo</button>
        <button class="chip" data-category="🚜" type="button">Maquinaria</button>
      </div>

      <div class="list-head">
        <h2>Cerca de ti</h2>
        <span id="visibleCount">{serviceCount}</span>
      </div>

      <div class="services-list" id="servicesList">
        {providers && providers.length > 0 ? (
          providers.map((item) => {
            const icon = item.category || '📍';
            const description = item.description || 'Sin descripción disponible.';
            return (
              <button
                type="button"
                class="card"
                data-id={item.id}
                data-category={icon}
                data-title={item.title ? item.title.toLowerCase() : ''}
                data-lat={item.lat ?? ''}
                data-lng={item.lng ?? ''}
              >
                <div class="card-icon">{icon}</div>
                <div class="info">
                  <div class="info-top">
                    <h3>{item.title}</h3>
                    <span class="eta">Ver mapa</span>
                  </div>
                  <p>{description}</p>
                </div>
              </button>
            );
          })
        ) : (
          <div class="empty">
            <div class="empty-mark">R</div>
            <p>Aún no hay servicios publicados.</p>
            <span>Sé el primero en registrar tu oficio.</span>
          </div>
        )}
      </div>

      <button class="cta" id="openModalBtn" type="button">+ Registrar mi servicio</button>
    </aside>

    <!-- CONTENEDOR DEL MAPA -->
    <main class="map-stage">
      <div id="map"></div>
      <button class="fab locate" id="locateBtn" type="button" aria-label="Mi ubicación">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="12" cy="12" r="3" fill="currentColor" />
          <path d="M12 3v3M12 18v3M3 12h3M18 12h3" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>
    </main>
  </div>

  <!-- MODAL REGISTRO -->
  <div id="registerModal" class="modal" aria-hidden="true">
    <div class="modal-scrim" id="modalScrim"></div>
    <div class="modal-card" role="dialog" aria-labelledby="modalTitle">
      <div class="modal-top">
        <div>
          <p class="kicker">Publicar</p>
          <h2 id="modalTitle">Tu servicio en el mapa</h2>
        </div>
        <button id="closeModalBtn" class="icon-btn" type="button" aria-label="Cerrar">&times;</button>
      </div>

      <form id="registerForm" class="form">
        <label>
          Nombre del servicio o prestador
          <input type="text" id="regTitle" placeholder="Ej: Don Pedro Carpintería" required />
        </label>

        <label>
          Categoría
          <select id="regCategory">
            <option value="🪚">Oficio / Trabajo</option>
            <option value="🍯">Producto / Venta local</option>
            <option value="🥾">Turismo / Hospedaje</option>
            <option value="🚜">Maquinaria / Transporte</option>
            <option value="📍">Otro</option>
          </select>
        </label>

        <label>
          Qué ofreces
          <textarea id="regDesc" rows="2" placeholder="Miel de ulmo, fletes, leña seca..."></textarea>
        </label>

        <label>
          WhatsApp
          <input type="tel" id="regPhone" placeholder="+56912345678" required />
        </label>

        <div class="gps-box">
          <div>
            <strong>Punto en el mapa</strong>
            <p>Toca el mapa o usa tu GPS.</p>
          </div>
          <button type="button" id="btnGps" class="ghost">Usar mi ubicación</button>
          <div class="coords">
            <input type="text" id="regLat" placeholder="Latitud" readonly required />
            <input type="text" id="regLng" placeholder="Longitud" readonly required />
          </div>
        </div>

        <label class="consent">
          <input type="checkbox" id="regConsent" required />
          <span>Autorizo publicar mi teléfono y posición en el mapa público de RedRural.</span>
        </label>

        <button type="submit" id="submitBtn" class="cta">Confirmar y publicar</button>
      </form>
    </div>
  </div>
</Layout>

<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<script is:inline define:vars={{ providers, supabaseUrl, supabaseAnonKey }}>
  document.addEventListener('DOMContentLoaded', () => {
    const defaultLat = -41.3917;
    const defaultLng = -73.4735;

    if (typeof L === 'undefined') return;

    // Inicializar cliente de Supabase
    const supabaseClient = window.supabase.createClient(supabaseUrl, supabaseAnonKey);

    const map = L.map('map', { zoomControl: false, attributionControl: false }).setView([defaultLat, defaultLng], 11);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; OpenStreetMap'
    }).addTo(map);

    L.control.zoom({ position: 'topright' }).addTo(map);
    setTimeout(() => map.invalidateSize(), 250);

    // --- GESTIÓN DE BOTTOM SHEET (MÓVIL) ---
    const sheet = document.getElementById('bottomSheet');
    const handle = document.getElementById('sheetHandle');
    let startY = 0;
    let currentY = 0;

    if (handle && sheet) {
      handle.addEventListener('touchstart', (e) => {
        startY = e.touches[0].clientY;
      }, { passive: true });

      handle.addEventListener('touchmove', (e) => {
        currentY = e.touches[0].clientY;
      }, { passive: true });

      handle.addEventListener('touchend', () => {
        const diff = startY - currentY;
        if (Math.abs(diff) < 30) return;

        if (diff > 30) {
          if (sheet.classList.contains('collapsed')) {
            sheet.classList.remove('collapsed');
            sheet.classList.add('half');
          } else if (sheet.classList.contains('half')) {
            sheet.classList.remove('half');
            sheet.classList.add('expanded');
          }
        } else if (diff < -30) {
          if (sheet.classList.contains('expanded')) {
            sheet.classList.remove('expanded');
            sheet.classList.add('half');
          } else if (sheet.classList.contains('half')) {
            sheet.classList.remove('half');
            sheet.classList.add('collapsed');
          }
        }
        
        setTimeout(() => map.invalidateSize(), 300);
      });
    }

    let tempMarker = null;
    const markersByKey = new Map();
    let activeCard = null;

    function pinIcon(emoji, selected) {
      const iconSymbol = emoji && emoji.trim() !== '' ? emoji : '📍';
      return L.divIcon({
        className: 'rr-pin-wrap',
        html: `<div class="rr-pin${selected ? ' is-on' : ''}"><span>${iconSymbol}</span></div>`,
        iconSize: [44, 52],
        iconAnchor: [22, 46],
        popupAnchor: [0, -40]
      });
    }

    function popupHtml(service) {
      const icon = service.category || '📍';
      const desc = service.description || 'Sin descripción';
      const phone = (service.phone || '').replace(/\D/g, '');
      return `
        <div class="rr-pop">
          <div class="rr-pop-kicker">${icon} Servicio</div>
          <h3>${service.title}</h3>
          <p>${desc}</p>
          ${phone ? `<a class="rr-wa" href="https://wa.me/${phone}" target="_blank" rel="noopener">Contactar por WhatsApp</a>` : ''}
        </div>
      `;
    }

    // --- RENDERIZADO DINÁMICO DE PROVEEDORES ---
    function addProviderToUI(service) {
      if (!service) return;
      
      // Evitar duplicados si ya está en la vista
      if (service.id && document.querySelector(`[data-id="${service.id}"]`)) return;

      const icon = service.category || '📍';
      const desc = service.description || 'Sin descripción disponible.';

      if (service.lat && service.lng) {
        const marker = L.marker([service.lat, service.lng], { icon: pinIcon(icon, false) })
          .addTo(map)
          .bindPopup(popupHtml(service), { className: 'rr-popup' });
        
        markersByKey.set(`${service.lat}|${service.lng}`, { marker, service, id: service.id });
      }

      const servicesList = document.getElementById('servicesList');
      if (servicesList) {
        const emptyMsg = servicesList.querySelector('.empty');
        if (emptyMsg) emptyMsg.remove();

        const cardBtn = document.createElement('button');
        cardBtn.type = 'button';
        cardBtn.className = 'card';
        if (service.id) cardBtn.setAttribute('data-id', service.id);
        cardBtn.setAttribute('data-category', icon);
        cardBtn.setAttribute('data-title', (service.title || '').toLowerCase());
        cardBtn.setAttribute('data-lat', service.lat ?? '');
        cardBtn.setAttribute('data-lng', service.lng ?? '');

        cardBtn.innerHTML = `
          <div class="card-icon">${icon}</div>
          <div class="info">
            <div class="info-top">
              <h3>${service.title}</h3>
              <span class="eta">Ver mapa</span>
            </div>
            <p>${desc}</p>
          </div>
        `;

        cardBtn.addEventListener('click', () => {
          flyTo(cardBtn.dataset.lat, cardBtn.dataset.lng, cardBtn);
        });

        servicesList.prepend(cardBtn);
      }
    }

    // Inicializar marcadores con datos precargados desde Astro (SSR)
    if (providers && Array.isArray(providers)) {
      providers.forEach((service) => {
        if (service.lat && service.lng) {
          const icon = service.category || '📍';
          const marker = L.marker([service.lat, service.lng], { icon: pinIcon(icon, false) })
            .addTo(map)
            .bindPopup(popupHtml(service), { className: 'rr-popup' });
          markersByKey.set(`${service.lat}|${service.lng}`, { marker, service, id: service.id });
        }
      });
    }

    function selectCard(card) {
      if (activeCard) activeCard.classList.remove('is-active');
      activeCard = card;
      if (card) card.classList.add('is-active');
    }

    function flyTo(latStr, lngStr, card) {
      const lat = parseFloat(latStr);
      const lng = parseFloat(lngStr);
      if (isNaN(lat) || isNaN(lng)) return;

      map.flyTo([lat, lng], 15, { duration: 1.05 });
      const found = markersByKey.get(`${lat}|${lng}`);
      if (found) {
        found.marker.openPopup();
      }
      selectCard(card);

      if (window.innerWidth <= 768 && sheet && sheet.classList.contains('expanded')) {
        sheet.classList.remove('expanded');
        sheet.classList.add('half');
        setTimeout(() => map.invalidateSize(), 300);
      }
    }

    document.querySelectorAll('.card').forEach((card) => {
      card.addEventListener('click', () => {
        flyTo(card.dataset.lat, card.dataset.lng, card);
      });
    });

    function setCoordinates(lat, lng) {
      const latInput = document.getElementById('regLat');
      const lngInput = document.getElementById('regLng');
      if (latInput && lngInput) {
        latInput.value = lat.toFixed(6);
        lngInput.value = lng.toFixed(6);
      }
      if (tempMarker) {
        tempMarker.setLatLng([lat, lng]);
      } else {
        tempMarker = L.marker([lat, lng], { icon: pinIcon('📍', true) }).addTo(map);
      }
    }

    map.on('click', (e) => setCoordinates(e.latlng.lat, e.latlng.lng));

    const locateBtn = document.getElementById('locateBtn');
    const btnGps = document.getElementById('btnGps');

    if (locateBtn) {
      locateBtn.addEventListener('click', () => {
        if (!('geolocation' in navigator)) return;
        navigator.geolocation.getCurrentPosition(
          (pos) => map.flyTo([pos.coords.latitude, pos.coords.longitude], 15),
          () => alert('Activa la ubicación para centrar el mapa.')
        );
      });
    }

    if (btnGps) {
      btnGps.addEventListener('click', () => {
        if (!('geolocation' in navigator)) {
          alert('Tu navegador no soporta geolocalización.');
          return;
        }

        btnGps.innerText = 'Buscando…';
        btnGps.disabled = true;

        navigator.geolocation.getCurrentPosition(
          (pos) => {
            setCoordinates(pos.coords.latitude, pos.coords.longitude);
            map.flyTo([pos.coords.latitude, pos.coords.longitude], 15);
            btnGps.innerText = 'Ubicación lista';
            btnGps.disabled = false;
            
            alert('Ubicación registrada');
          },
          (error) => {
            let msg = 'Ubicación asignada.';
            if (error.code === error.PERMISSION_DENIED) {
              msg = 'Permiso denegado. Por favor activa la ubicación en tu navegador.';
            }
            alert(msg);
            btnGps.innerText = 'Usar mi ubicación';
            btnGps.disabled = false;
          },
          { enableHighAccuracy: true, timeout: 10000 }
        );
      });
    }

    const modal = document.getElementById('registerModal');
    const openBtn = document.getElementById('openModalBtn');
    const closeBtn = document.getElementById('closeModalBtn');
    const scrim = document.getElementById('modalScrim');

    function openModal() {
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
    }
    function closeModal() {
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
    }

    if (openBtn) openBtn.addEventListener('click', openModal);
    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (scrim) scrim.addEventListener('click', closeModal);

    let activeCategory = 'todos';
    const searchInput = document.getElementById('searchInput');
    const visibleCount = document.getElementById('visibleCount');

    function applyFilters() {
      const query = (searchInput?.value || '').toLowerCase().trim();
      const cards = document.querySelectorAll('.card');
      let shown = 0;
      cards.forEach((card) => {
        const title = card.getAttribute('data-title') || '';
        const category = card.getAttribute('data-category') || '';
        const matchText = !query || title.includes(query);
        const matchCat = activeCategory === 'todos' || category === activeCategory;
        const visible = matchText && matchCat;
        card.style.display = visible ? 'flex' : 'none';
        if (visible) shown += 1;
      });
      if (visibleCount) visibleCount.textContent = String(shown);
    }

    if (searchInput) searchInput.addEventListener('input', applyFilters);

    document.querySelectorAll('.chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        document.querySelectorAll('.chip').forEach((c) => c.classList.remove('active'));
        chip.classList.add('active');
        activeCategory = chip.dataset.category;
        applyFilters();
      });
    });

    const registerForm = document.getElementById('registerForm');
    if (registerForm) {
      registerForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const consent = document.getElementById('regConsent').checked;
        if (!consent) {
          alert('Debes aceptar el consentimiento.');
          return;
        }

        const latVal = parseFloat(document.getElementById('regLat').value);
        const lngVal = parseFloat(document.getElementById('regLng').value);
        if (isNaN(latVal) || isNaN(lngVal)) {
          alert('Marca tu ubicación en el mapa o usa el GPS.');
          return;
        }

        const submitBtn = document.getElementById('submitBtn');
        submitBtn.innerText = 'Publicando…';
        submitBtn.disabled = true;

        const payload = {
          title: document.getElementById('regTitle').value,
          category: document.getElementById('regCategory').value || '📍',
          description: document.getElementById('regDesc').value,
          phone: document.getElementById('regPhone').value,
          lat: latVal,
          lng: lngVal
        };

        try {
          const { error } = await supabaseClient.from('providers').insert([payload]);
          if (error) throw error;

          alert('Tu servicio ya está en el mapa de RedRural.');
          closeModal();
          registerForm.reset();
          submitBtn.innerText = 'Confirmar y publicar';
          submitBtn.disabled = false;
        } catch (err) {
          alert('No se pudo guardar: ' + err.message);
          submitBtn.innerText = 'Confirmar y publicar';
          submitBtn.disabled = false;
        }
      });
    }

    // --- ESCUCHADOR EN TIEMPO REAL (REALTIME) ---
    supabaseClient
      .channel('public:providers')
      .on(
        'postgres_changes',
        { event: '*', schema: 'public', table: 'providers' },
        (payload) => {
          if (payload.eventType === 'INSERT') {
            addProviderToUI(payload.new);
            applyFilters();
          }

          if (payload.eventType === 'DELETE') {
            const deletedId = payload.old.id;

            const cardToRemove = document.querySelector(`[data-id="${deletedId}"]`);
            if (cardToRemove) cardToRemove.remove();

            markersByKey.forEach((val, key) => {
              if (val.id === deletedId) {
                map.removeLayer(val.marker);
                markersByKey.delete(key);
              }
            });

            applyFilters();
          }

          if (payload.eventType === 'UPDATE') {
            window.location.reload();
          }
        }
      )
      .subscribe();
  });
</script>

<style is:global>
/* RESET GLOBAL */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html, body {
  width: 100%;
  height: 100%;
  overflow: hidden;
  font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  background-color: #0b0b0c;
  color: #0b0b0c;
}

/* LAYOUT PRINCIPAL */
.app-layout {
  display: flex;
  width: 100vw;
  height: 100vh;
  position: relative;
}

.sidebar {
  width: 380px;
  min-width: 380px;
  height: 100%;
  background: #ffffff;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  padding: 20px 18px 16px;
  gap: 14px;
  box-shadow: 4px 0 24px rgba(0,0,0,0.12);
  position: relative;
}

.map-stage {
  flex: 1;
  height: 100%;
  position: relative;
}

#map {
  width: 100%;
  height: 100%;
  background: #e5e3df;
}

.sheet-handle-area { display: none; }

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
}

.mark {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background: #0b0b0c;
  color: #fff;
  display: grid;
  place-items: center;
  font-weight: 800;
  font-size: 1.2rem;
}

.brand h1 {
  font-size: 1.2rem;
  font-weight: 800;
  color: #0b0b0c;
}

.brand p {
  font-size: 0.78rem;
  color: #6b6b6b;
}

.search-wrap { position: relative; }

.search-icon {
  position: absolute;
  left: 16px;
  top: 50%;
  transform: translateY(-50%);
  color: #6b6b6b;
  pointer-events: none;
}

.search-wrap input {
  width: 100%;
  height: 48px;
  padding: 0 16px 0 46px;
  border: 1px solid #e0e0e0;
  border-radius: 24px;
  background: #f3f3f3;
  font-size: 0.9rem;
  outline: none;
  font-family: inherit;
  color: #0b0b0c;
}

.search-wrap input:focus {
  border-color: #0b0b0c;
  background: #fff;
}

.chips {
  display: flex;
  gap: 8px;
  overflow-x: auto;
  scrollbar-width: none;
  padding-bottom: 4px;
}
.chips::-webkit-scrollbar { display: none; }

.chip {
  border: 0;
  background: #ececec;
  color: #0b0b0c;
  padding: 8px 14px;
  border-radius: 999px;
  font-size: 0.8rem;
  font-weight: 600;
  cursor: pointer;
  white-space: nowrap;
  font-family: inherit;
}

.chip.active {
  background: #0b0b0c;
  color: #fff;
}

.list-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.list-head h2 { font-size: 0.95rem; color: #0b0b0c; }
.list-head span { font-size: 0.75rem; font-weight: 700; color: #6b6b6b; }

.services-list {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.card {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 12px;
  border: 1px solid #f0f0f0;
  border-radius: 16px;
  background: #f6f6f6;
  cursor: pointer;
  text-align: left;
  font-family: inherit;
  width: 100%;
  transition: background 0.2s ease;
}

.card:hover,
.card.is-active { background: #ececec; }
.card.is-active { border-color: #0b0b0c; }

.card-icon {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: #0b0b0c;
  display: grid;
  place-items: center;
  font-size: 1.2rem;
  flex-shrink: 0;
}

.info { min-width: 0; flex: 1; }
.info-top { display: flex; justify-content: space-between; gap: 8px; align-items: baseline; }
.card h3 { font-size: 0.9rem; font-weight: 700; color: #0b0b0c; }
.eta { font-size: 0.72rem; font-weight: 700; color: #06c167; white-space: nowrap; }
.card p {
  margin-top: 4px;
  font-size: 0.78rem;
  color: #5a5a5a;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.empty { padding: 32px 12px; text-align: center; color: #6b6b6b; }
.empty-mark {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: #0b0b0c;
  color: #fff;
  display: grid;
  place-items: center;
  margin: 0 auto 12px;
  font-weight: 800;
}

.cta {
  height: 48px;
  border: 0;
  border-radius: 12px;
  background: #0b0b0c;
