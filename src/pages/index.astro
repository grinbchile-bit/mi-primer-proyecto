---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

const { data: providers, error } = await supabase.from('providers').select('*');

if (error) {
  console.error('Error al cargar servicios de Supabase:', error);
}

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
const serviceCount = providers?.length ?? 0;
---

<Layout title="RedRural — Los Muermos">
	<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

	<div class="app">
		<main class="map-stage">
			<div id="map"></div>
			<div class="map-veil"></div>

			<button class="fab locate" id="locateBtn" type="button" aria-label="Mi ubicación">
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<circle cx="12" cy="12" r="3" fill="currentColor" />
					<path d="M12 3v3M12 18v3M3 12h3M18 12h3" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
				</svg>
			</button>
		</main>

		<aside class="sheet" id="sheet">
			<div class="sheet-handle" aria-hidden="true"></div>

			<header class="brand-bar">
				<div class="brand">
					<div class="mark">R</div>
					<div>
						<h1>RedRural</h1>
						<p>Los Muermos · {serviceCount} {serviceCount === 1 ? 'servicio' : 'servicios'}</p>
					</div>
				</div>
			</header>

			<div class="search-wrap">
				<svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" />
					<path d="M20 20l-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
				</svg>
				<input type="text" id="searchInput" placeholder="¿Qué necesitas? Leña, flete, miel..." autocomplete="off" />
			</div>

			<div class="chips" id="categoryFilters" role="tablist">
				<button class="chip active" data-category="todos" type="button">Todos</button>
				<button class="chip" data-category="🪚" type="button">Oficios</button>
				<button class="chip" data-category="🍯" type="button">Productos</button>
				<button class="chip" data-category="🥾" type="button">Turismo</button>
				<button class="chip" data-category="🚜" type="button">Maquinaria</button>
			</div>

			<div class="list-head">
				<h2>Cerca de ti</h2>
				<span id="visibleCount">{serviceCount}</span>
			</div>

			<div class="services-list" id="servicesList">
				{providers && providers.length > 0 ? (
					providers.map((item) => (
						<button
							type="button"
							class="card"
							data-category={item.category || '📍'}
							data-title={item.title ? item.title.toLowerCase() : ''}
							data-sector={item.sector ? item.sector.toLowerCase() : ''}
							data-lat={item.lat}
							data-lng={item.lng}
						>
							<div class="card-icon">{item.category || '📍'}</div>
							<div class="info">
								<div class="info-top">
									<h3>{item.title}</h3>
									<span class="eta">Ver mapa</span>
								</div>
								<p>{item.description || 'Sin descripción disponible.'}</p>
								<span class="meta">{item.sector || 'Sector rural'}</span>
							</div>
						</button>
					))
				) : (
					<div class="empty">
						<div class="empty-mark">R</div>
						<p>Aún no hay servicios publicados.</p>
						<span>Sé el primero en registrar tu oficio.</span>
					</div>
				)}
			</div>

			<button class="cta" id="openModalBtn" type="button">Registrar mi servicio</button>
		</aside>
	</div>

	<div id="registerModal" class="modal" aria-hidden="true">
		<div class="modal-scrim" id="modalScrim"></div>
		<div class="modal-card" role="dialog" aria-labelledby="modalTitle">
			<div class="modal-top">
				<div>
					<p class="kicker">Publicar</p>
					<h2 id="modalTitle">Tu servicio en el mapa</h2>
				</div>
				<button id="closeModalBtn" class="icon-btn" type="button" aria-label="Cerrar">&times;</button>
			</div>

			<form id="registerForm" class="form">
				<label>
					Nombre del servicio o prestador
					<input type="text" id="regTitle" placeholder="Ej: Don Pedro Carpintería" required />
				</label>

				<label>
					Categoría
					<select id="regCategory">
						<option value="🪚">Oficio / Trabajo</option>
						<option value="🍯">Producto / Venta local</option>
						<option value="🥾">Turismo / Hospedaje</option>
						<option value="🚜">Maquinaria / Transporte</option>
						<option value="📍">Otro</option>
					</select>
				</label>

				<label>
					Sector
					<select id="regSector" required>
						<option value="" disabled selected>Elige tu sector</option>
						<option value="El Melí">El Melí</option>
						<option value="San Carlos">San Carlos</option>
						<option value="Cordillera Vieja">Cordillera Vieja</option>
						<option value="Hua Huar">Hua Huar</option>
						<option value="Los Piques">Los Piques</option>
						<option value="Esperanza">Esperanza</option>
						<option value="Tambor Bajo">Tambor Bajo</option>
						<option value="Miramar Bajo">Miramar Bajo</option>
						<option value="Estaquilla">Estaquilla</option>
						<option value="Los Muermos Centro">Los Muermos Centro</option>
						<option value="Otro">Otro sector</option>
					</select>
				</label>

				<label>
					Qué ofreces
					<textarea id="regDesc" rows="2" placeholder="Miel de ulmo, fletes, leña seca..."></textarea>
				</label>

				<label>
					WhatsApp
					<input type="tel" id="regPhone" placeholder="+56 9 1234 5678" required />
				</label>

				<div class="gps-box">
					<div>
						<strong>Punto en el mapa</strong>
						<p>Toca el mapa o usa tu GPS.</p>
					</div>
					<button type="button" id="btnGps" class="ghost">Usar mi ubicación</button>
					<div class="coords">
						<input type="text" id="regLat" placeholder="Latitud" readonly required />
						<input type="text" id="regLng" placeholder="Longitud" readonly required />
					</div>
				</div>

				<label class="consent">
					<input type="checkbox" id="regConsent" required />
					<span>Autorizo publicar mi teléfono y posición en el mapa público de RedRural.</span>
				</label>

				<button type="submit" id="submitBtn" class="cta">Confirmar y publicar</button>
			</form>
		</div>
	</div>
</Layout>

<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script is:inline define:vars={{ providers, supabaseUrl, supabaseAnonKey }}>
  document.addEventListener('DOMContentLoaded', () => {
    const defaultLat = -41.3917;
    const defaultLng = -73.4735;
    const map = L.map('map', { zoomControl: false, attributionControl: false }).setView([defaultLat, defaultLng], 11);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; OpenStreetMap'
    }).addTo(map);

    L.control.zoom({ position: 'bottomright' }).addTo(map);
    setTimeout(() => map.invalidateSize(), 250);

    let tempMarker = null;
    const markersByKey = new Map();
    let activeCard = null;

    function pinIcon(emoji, selected) {
      return L.divIcon({
        className: 'rr-pin-wrap',
        html: `<div class="rr-pin${selected ? ' is-on' : ''}"><span>${emoji || '📍'}</span></div>`,
        iconSize: [44, 52],
        iconAnchor: [22, 46],
        popupAnchor: [0, -40]
      });
    }

    function popupHtml(service) {
      const desc = service.description || 'Sin descripción';
      const sector = service.sector || 'Sector rural';
      const phone = (service.phone || '').replace(/\D/g, '');
      return `
        <div class="rr-pop">
          <div class="rr-pop-kicker">${service.category || '📍'} ${sector}</div>
          <h3>${service.title}</h3>
          <p>${desc}</p>
          ${phone ? `<a class="rr-wa" href="https://wa.me/${phone}" target="_blank" rel="noopener">Contactar por WhatsApp</a>` : ''}
        </div>
      `;
    }

    if (providers && Array.isArray(providers)) {
      providers.forEach((service) => {
        if (service.lat && service.lng) {
          const marker = L.marker([service.lat, service.lng], { icon: pinIcon(service.category, false) })
            .addTo(map)
            .bindPopup(popupHtml(service), { className: 'rr-popup' });
          markersByKey.set(`${service.lat}|${service.lng}`, { marker, service });
        }
      });
    }

    function selectCard(card) {
      if (activeCard) activeCard.classList.remove('is-active');
      activeCard = card;
      if (card) card.classList.add('is-active');
    }

    function flyTo(lat, lng, card) {
      if (!lat || !lng) return;
      map.flyTo([lat, lng], 15, { duration: 1.05 });
      const found = markersByKey.get(`${lat}|${lng}`);
      if (found) {
        found.marker.openPopup();
      }
      selectCard(card);
    }

    document.querySelectorAll('.card').forEach((card) => {
      card.addEventListener('click', () => {
        flyTo(card.dataset.lat, card.dataset.lng, card);
      });
    });

    function setCoordinates(lat, lng) {
      const latInput = document.getElementById('regLat');
      const lngInput = document.getElementById('regLng');
      if (latInput && lngInput) {
        latInput.value = lat.toFixed(6);
        lngInput.value = lng.toFixed(6);
      }
      if (tempMarker) {
        tempMarker.setLatLng([lat, lng]);
      } else {
        tempMarker = L.marker([lat, lng], { icon: pinIcon('📍', true) }).addTo(map);
      }
    }

    map.on('click', (e) => setCoordinates(e.latlng.lat, e.latlng.lng));

    const locateBtn = document.getElementById('locateBtn');
    const btnGps = document.getElementById('btnGps');

    function useGps(button, labelReady) {
      if (!('geolocation' in navigator)) {
        alert('Tu navegador no soporta geolocalización.');
        return;
      }
      const original = button.innerText;
      button.innerText = 'Buscando…';
      navigator.geolocation.getCurrentPosition(
        (pos) => {
          const { latitude, longitude } = pos.coords;
          setCoordinates(latitude, longitude);
          map.flyTo([latitude, longitude], 15);
          button.innerText = labelReady || original;
        },
        () => {
          alert('No se pudo obtener la ubicación. Toca el mapa para marcar el punto.');
          button.innerText = original;
        },
        { enableHighAccuracy: true }
      );
    }

    if (locateBtn) {
      locateBtn.addEventListener('click', () => {
        if (!('geolocation' in navigator)) return;
        navigator.geolocation.getCurrentPosition(
          (pos) => map.flyTo([pos.coords.latitude, pos.coords.longitude], 15),
          () => alert('Activa la ubicación para centrar el mapa.')
        );
      });
    }

    if (btnGps) {
      btnGps.addEventListener('click', () => useGps(btnGps, 'Ubicación lista'));
    }

    const modal = document.getElementById('registerModal');
    const openBtn = document.getElementById('openModalBtn');
    const closeBtn = document.getElementById('closeModalBtn');
    const scrim = document.getElementById('modalScrim');

    function openModal() {
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
    }
    function closeModal() {
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
    }

    if (openBtn) openBtn.addEventListener('click', openModal);
    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (scrim) scrim.addEventListener('click', closeModal);

    let activeCategory = 'todos';
    const searchInput = document.getElementById('searchInput');
    const visibleCount = document.getElementById('visibleCount');

    function applyFilters() {
      const query = (searchInput?.value || '').toLowerCase().trim();
      const cards = document.querySelectorAll('.card');
      let shown = 0;
      cards.forEach((card) => {
        const title = card.getAttribute('data-title') || '';
        const sector = card.getAttribute('data-sector') || '';
        const category = card.getAttribute('data-category') || '';
        const matchText = !query || title.includes(query) || sector.includes(query);
        const matchCat = activeCategory === 'todos' || category === activeCategory;
        const visible = matchText && matchCat;
        card.style.display = visible ? 'flex' : 'none';
        if (visible) shown += 1;
      });
      if (visibleCount) visibleCount.textContent = String(shown);
    }

    if (searchInput) searchInput.addEventListener('input', applyFilters);

    document.querySelectorAll('.chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        document.querySelectorAll('.chip').forEach((c) => c.classList.remove('active'));
        chip.classList.add('active');
        activeCategory = chip.dataset.category;
        applyFilters();
      });
    });

    const registerForm = document.getElementById('registerForm');
    if (registerForm) {
      registerForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const consent = document.getElementById('regConsent').checked;
        if (!consent) {
          alert('Debes aceptar el consentimiento para publicar tus datos.');
          return;
        }

        const latVal = parseFloat(document.getElementById('regLat').value);
        const lngVal = parseFloat(document.getElementById('regLng').value);
        if (isNaN(latVal) || isNaN(lngVal)) {
          alert('Marca tu ubicación en el mapa o usa el GPS.');
          return;
        }

        const submitBtn = document.getElementById('submitBtn');
        submitBtn.innerText = 'Publicando…';
        submitBtn.disabled = true;

        const payload = {
          title: document.getElementById('regTitle').value,
          category: document.getElementById('regCategory').value,
          sector: document.getElementById('regSector').value,
          description: document.getElementById('regDesc').value,
          phone: document.getElementById('regPhone').value,
          lat: latVal,
          lng: lngVal
        };

        try {
          const { createClient } = await import('https://cdn.jsdelivr.net/npm/@supabase/supabase-js/+esm');
          const supabaseClient = createClient(supabaseUrl, supabaseAnonKey);
          const { error } = await supabaseClient.from('providers').insert([payload]).select();
          if (error) throw error;
          alert('Tu servicio ya está en el mapa de RedRural.');
          window.location.reload();
        } catch (err) {
          alert('No se pudo guardar: ' + err.message);
          submitBtn.innerText = 'Confirmar y publicar';
          submitBtn.disabled = false;
        }
      });
    }
  });
</script>

<style>
	:global(*) { box-sizing: border-box; }

	:global(body) {
		margin: 0;
		font-family: Inter, system-ui, -apple-system, sans-serif;
		background: #0b0b0c;
		color: #0b0b0c;
		-webkit-font-smoothing: antialiased;
	}

	.app {
		position: relative;
		height: 100vh;
		height: 100dvh;
		overflow: hidden;
	}

	.map-stage {
		position: absolute;
		inset: 0;
	}

	#map {
		width: 100%;
		height: 100%;
		background: #dcdcdc;
	}

	:global(.leaflet-tile-pane) {
		filter: grayscale(0.4) saturate(0.65) contrast(1.08);
	}

	.map-veil {
		pointer-events: none;
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgba(11,11,12,0.06) 0%, transparent 18%, transparent 82%, rgba(11,11,12,0.08) 100%);
	}

	.fab {
		position: absolute;
		right: 16px;
		bottom: 88px;
		width: 48px;
		height: 48px;
		border: 0;
		border-radius: 50%;
		background: #fff;
		color: #0b0b0c;
		box-shadow: 0 8px 24px rgba(0,0,0,0.18);
		cursor: pointer;
		display: grid;
		place-items: center;
		z-index: 500;
	}

	:global(.leaflet-control-zoom) {
		border: 0 !important;
		box-shadow: 0 8px 24px rgba(0,0,0,0.16) !important;
		border-radius: 12px !important;
		overflow: hidden;
		margin-right: 16px !important;
		margin-bottom: 24px !important;
	}

	:global(.leaflet-control-zoom a) {
		width: 40px !important;
		height: 40px !important;
		line-height: 40px !important;
		color: #0b0b0c !important;
		border: 0 !important;
		font-size: 18px !important;
	}

	.sheet {
		position: absolute;
		left: 16px;
		top: 16px;
		bottom: 16px;
		width: 400px;
		background: #fff;
		display: flex;
		flex-direction: column;
		padding: 20px 18px 16px;
		gap: 14px;
		z-index: 20;
		border-radius: 24px;
		box-shadow: 0 16px 48px rgba(0,0,0,0.18);
	}

	.sheet-handle {
		display: none;
		width: 44px;
		height: 5px;
		border-radius: 99px;
		background: #d6d6d6;
		margin: 0 auto 4px;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.mark {
		width: 42px;
		height: 42px;
		border-radius: 50%;
		background: #0b0b0c;
		color: #fff;
		display: grid;
		place-items: center;
		font-weight: 800;
		letter-spacing: -0.04em;
	}

	.brand h1 {
		margin: 0;
		font-size: 1.2rem;
		letter-spacing: -0.04em;
		font-weight: 800;
	}

	.brand p {
		margin: 2px 0 0;
		font-size: 0.78rem;
		color: #6b6b6b;
		font-weight: 500;
	}

	.search-wrap {
		position: relative;
	}

	.search-icon {
		position: absolute;
		left: 16px;
		top: 50%;
		transform: translateY(-50%);
		color: #6b6b6b;
	}

	.search-wrap input {
		width: 100%;
		height: 54px;
		padding: 0 16px 0 46px;
		border: 0;
		border-radius: 28px;
		background: #f3f3f3;
		font-size: 0.95rem;
		outline: none;
		font-family: inherit;
	}

	.search-wrap input:focus {
		box-shadow: 0 0 0 2px #0b0b0c;
		background: #fff;
	}

	.chips {
		display: flex;
		gap: 8px;
		overflow-x: auto;
		scrollbar-width: none;
	}

	.chips::-webkit-scrollbar { display: none; }

	.chip {
		border: 0;
		background: #ececec;
		color: #0b0b0c;
		padding: 9px 14px;
		border-radius: 999px;
		font-size: 0.8rem;
		font-weight: 600;
		cursor: pointer;
		white-space: nowrap;
		font-family: inherit;
		flex-shrink: 0;
	}

	.chip.active {
		background: #0b0b0c;
		color: #fff;
	}

	.brand-bar,
	.search-wrap,
	.chips,
	.list-head,
	.cta {
		flex-shrink: 0;
	}

	.list-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
	}

	.list-head h2 {
		margin: 0;
		font-size: 0.95rem;
		letter-spacing: -0.03em;
	}

	.list-head span {
		font-size: 0.75rem;
		font-weight: 700;
		color: #6b6b6b;
	}

	.services-list {
		flex: 1;
		min-height: 0;
		overflow-y: auto;
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding-right: 2px;
	}

	.card {
		display: flex;
		gap: 12px;
		padding: 12px;
		border: 0;
		border-radius: 16px;
		background: #f6f6f6;
		cursor: pointer;
		text-align: left;
		font-family: inherit;
		width: 100%;
	}

	.card:hover,
	.card.is-active {
		background: #ececec;
	}

	.card.is-active {
		box-shadow: inset 0 0 0 2px #0b0b0c;
	}

	.card-icon {
		width: 48px;
		height: 48px;
		border-radius: 50%;
		background: #0b0b0c;
		display: grid;
		place-items: center;
		font-size: 1.25rem;
		flex-shrink: 0;
	}

	.info { min-width: 0; flex: 1; }

	.info-top {
		display: flex;
		justify-content: space-between;
		gap: 8px;
		align-items: baseline;
	}

	.card h3 {
		margin: 0;
		font-size: 0.95rem;
		letter-spacing: -0.03em;
		font-weight: 700;
	}

	.eta {
		font-size: 0.72rem;
		font-weight: 700;
		color: #06c167;
		white-space: nowrap;
	}

	.card p {
		margin: 4px 0 6px;
		font-size: 0.8rem;
		color: #5a5a5a;
		line-height: 1.35;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.meta {
		font-size: 0.72rem;
		font-weight: 600;
		color: #8a8a8a;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	.empty {
		padding: 32px 12px;
		text-align: center;
		color: #6b6b6b;
	}

	.empty-mark {
		width: 48px;
		height: 48px;
		border-radius: 50%;
		background: #0b0b0c;
		color: #fff;
		display: grid;
		place-items: center;
		margin: 0 auto 12px;
		font-weight: 800;
	}

	.empty p { margin: 0 0 4px; font-weight: 700; color: #0b0b0c; }
	.empty span { font-size: 0.8rem; }

	.cta {
		height: 52px;
		border: 0;
		border-radius: 12px;
		background: #0b0b0c;
		color: #fff;
		font-weight: 700;
		font-size: 0.95rem;
		cursor: pointer;
		font-family: inherit;
	}

	.cta:disabled { opacity: 0.55; }

	.modal {
		position: fixed;
		inset: 0;
		z-index: 3000;
		display: none;
		place-items: end center;
	}

	.modal.is-open { display: grid; }

	.modal-scrim {
		position: absolute;
		inset: 0;
		background: rgba(11,11,12,0.55);
	}

	.modal-card {
		position: relative;
		width: min(480px, 100%);
		max-height: 92vh;
		overflow: auto;
		background: #fff;
