---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

const { data: providers, error } = await supabase.from('providers').select('*');

if (error) {
  console.error('Error al cargar servicios de Supabase:', error);
}

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
---

<Layout title="RedRural - Los Muermos">
	<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

	<div class="app-container">
		<!-- Panel Lateral -->
		<aside class="sidebar">
			<header class="header">
				<div class="brand">
					<span class="logo-icon">🌿</span>
					<div>
						<h1>RedRural</h1>
						<p>Servicios y Oficios de Los Muermos</p>
					</div>
				</div>
			</header>

			<div class="search-box">
				<input type="text" id="searchInput" placeholder="Buscar por servicio o sector (ej. Hua Huar, Leña)..." />
			</div>

			<div class="categories" id="categoryFilters">
				<button class="chip active" data-category="todos">Todos</button>
				<button class="chip" data-category="🪚">🪚 Oficios</button>
				<button class="chip" data-category="🍯">🍯 Productos</button>
				<button class="chip" data-category="🥾">🥾 Turismo</button>
				<button class="chip" data-category="🚜">🚜 Maquinaria</button>
			</div>

			<div class="services-list" id="servicesList">
				{providers && providers.length > 0 ? (
					providers.map((item) => (
						<div 
							class="card" 
							data-category={item.category || '📍'}
							data-title={item.title ? item.title.toLowerCase() : ''}
							data-sector={item.sector ? item.sector.toLowerCase() : ''}
							onclick={`centerMap(${item.lat}, ${item.lng})`}
						>
							<div class="card-icon">{item.category || '📍'}</div>
							<div class="info">
								<h3>{item.title}</h3>
								<p>{item.description || 'Sin descripción disponible.'}</p>
								<span class="sector">📍 {item.sector || 'Sector Rural'}</span>
							</div>
						</div>
					))
				) : (
					<div class="empty-state">
						<span class="empty-icon">🌾</span>
						<p>No hay servicios registrados aún.</p>
					</div>
				)}
			</div>

			<button class="btn-publish" id="openModalBtn">+ Registrar mi Habilidad o Servicio</button>
		</aside>

		<!-- Mapa Principal -->
		<main class="map-container">
			<div id="map"></div>
		</main>
	</div>

	<!-- Modal de Autorregistro con Consentimiento y GPS -->
	<div id="registerModal" class="modal-overlay">
		<div class="modal-content">
			<div class="modal-header">
				<h2>🌱 Registrar Servicio u Oficio</h2>
				<button id="closeModalBtn" class="close-btn">&times;</button>
			</div>
			
			<form id="registerForm" class="register-form">
				<label>
					Nombre del Servicio o Prestador
					<input type="text" id="regTitle" placeholder="Ej: Don Pedro Carpintería" required />
				</label>

				<label>
					Categoría
					<select id="regCategory">
						<option value="🪚">🪚 Oficio / Trabajo</option>
						<option value="🍯">🍯 Producto / Venta local</option>
						<option value="🥾">🥾 Turismo / Hospedaje</option>
						<option value="🚜">🚜 Maquinaria / Transporte</option>
						<option value="📍">📍 Otro</option>
					</select>
				</label>

				<label>
					Sector / Localidad Rural
					<select id="regSector" required>
						<option value="" disabled selected>Selecciona tu sector...</option>
						<option value="El Melí">El Melí</option>
						<option value="San Carlos">San Carlos</option>
						<option value="Cordillera Vieja">Cordillera Vieja</option>
						<option value="Hua Huar">Hua Huar</option>
						<option value="Los Piques">Los Piques</option>
						<option value="Esperanza">Esperanza</option>
						<option value="Tambor Bajo">Tambor Bajo</option>
						<option value="Miramar Bajo">Miramar Bajo</option>
						<option value="Estaquilla">Estaquilla</option>
						<option value="Los Muermos Centro">Los Muermos Centro</option>
						<option value="Otro">Otro Sector</option>
					</select>
				</label>

				<label>
					Descripción de lo que ofreces
					<textarea id="regDesc" rows="2" placeholder="Ej: Miel de ulmo, fletes, leña seca..."></textarea>
				</label>

				<label>
					Teléfono / WhatsApp de contacto
					<input type="tel" id="regPhone" placeholder="+56912345678" required />
				</label>

				<div class="coords-info">
					<p>📌 <b>Geolocalización:</b> Toca el mapa o usa tu ubicación actual.</p>
					<button type="button" id="btnGps" class="btn-gps">📡 Usar mi Ubicación Actual (GPS)</button>
					<div class="coords-fields">
						<input type="text" id="regLat" placeholder="Latitud" readonly required />
						<input type="text" id="regLng" placeholder="Longitud" readonly required />
					</div>
				</div>

				<!-- Casilla de Consentimiento -->
				<label class="consent-label">
					<input type="checkbox" id="regConsent" required />
					<span>Autorizo publicar mi teléfono y posición en el mapa público de RedRural.</span>
				</label>

				<button type="submit" id="submitBtn" class="btn-submit">Guardar en el Mapa</button>
			</form>
		</div>
	</div>
</Layout>

<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script is:inline define:vars={{ providers, supabaseUrl, supabaseAnonKey }}>
  document.addEventListener('DOMContentLoaded', () => {
    const defaultLat = -41.3917;
    const defaultLng = -73.4735;
    const zoom = 11;

    const map = L.map('map').setView([defaultLat, defaultLng], zoom);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; OpenStreetMap'
    }).addTo(map);

    let tempMarker = null;

    const defaultIcon = L.icon({
      iconUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon.png',
      iconRetinaUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon-2x.png',
      shadowUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png',
      iconSize: [25, 41],
      iconAnchor: [12, 41],
      popupAnchor: [1, -34],
      shadowSize: [41, 41]
    });

    if (providers && Array.isArray(providers)) {
      providers.forEach(service => {
        if (service.lat && service.lng) {
          const icon = service.category || '📍';
          const desc = service.description || '';

          L.marker([service.lat, service.lng], { icon: defaultIcon })
            .addTo(map)
            .bindPopup(`
              <div style="font-family: system-ui, sans-serif; min-width: 170px;">
                <h3 style="margin:0 0 6px 0; font-size:1rem; color:#1b4332;">${icon} ${service.title}</h3>
                <p style="margin:0 0 8px 0; font-size: 0.85rem; color:#4a5568;">${desc}</p>
                <span style="font-size:0.75rem; color:#2d6a4f; font-weight:600;">📍 Sector: ${service.sector || 'Sector Rural'}</span><br>
                <a href="https://wa.me/${service.phone}" target="_blank" style="display:inline-block; margin-top:8px; padding: 4px 8px; background-color:#2d6a4f; color:white; font-size:0.75rem; border-radius:4px; font-weight:bold; text-decoration:none;">💬 Contactar por WhatsApp</a>
              </div>
            `);
        }
      });
    }

    window.centerMap = function(targetLat, targetLng) {
      if (targetLat && targetLng) {
        map.flyTo([targetLat, targetLng], 15, { duration: 1.2 });
      }
    };

    // Selección manual en el mapa
    map.on('click', (e) => {
      setCoordinates(e.latlng.lat, e.latlng.lng);
    });

    // Función auxiliar para actualizar coordenadas y marcador temporal
    function setCoordinates(lat, lng) {
      const latInput = document.getElementById('regLat');
      const lngInput = document.getElementById('regLng');
      
      if (latInput && lngInput) {
        latInput.value = lat.toFixed(6);
        lngInput.value = lng.toFixed(6);
      }

      if (tempMarker) {
        tempMarker.setLatLng([lat, lng]);
      } else {
        tempMarker = L.marker([lat, lng], { icon: defaultIcon }).addTo(map);
      }
    }

    // Botón GPS
    const btnGps = document.getElementById('btnGps');
    if (btnGps) {
      btnGps.addEventListener('click', () => {
        if ('geolocation' in navigator) {
          btnGps.innerText = "Obteniendo ubicación...";
          navigator.geolocation.getCurrentPosition(
            (pos) => {
              const { latitude, longitude } = pos.coords;
              setCoordinates(latitude, longitude);
              map.flyTo([latitude, longitude], 15);
              btnGps.innerText = "✅ Ubicación Detectada";
            },
            (err) => {
              alert("No se pudo obtener la ubicación automáticamente. Por favor haz clic directamente en el mapa.");
              btnGps.innerText = "📡 Usar mi Ubicación Actual (GPS)";
            },
            { enableHighAccuracy: true }
          );
        } else {
          alert("Tu navegador no soporta geolocalización GPS.");
        }
      });
    }

    // Modal
    const modal = document.getElementById('registerModal');
    const openBtn = document.getElementById('openModalBtn');
    const closeBtn = document.getElementById('closeModalBtn');

    if (openBtn && modal) {
      openBtn.addEventListener('click', () => modal.classList.add('active'));
    }
    if (closeBtn && modal) {
      closeBtn.addEventListener('click', () => modal.classList.remove('active'));
    }

    // Buscador
    const searchInput = document.getElementById('searchInput');
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase();
        const cards = document.querySelectorAll('.card');

        cards.forEach(card => {
          const title = card.getAttribute('data-title') || '';
          const sector = card.getAttribute('data-sector') || '';
          if (title.includes(query) || sector.includes(query)) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    }

    // Envio a Supabase con confirmación
    const registerForm = document.getElementById('registerForm');
    if (registerForm) {
      registerForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        const consent = document.getElementById('regConsent').checked;
        if (!consent) {
          alert("Debes aceptar la casilla de consentimiento para publicar tus datos.");
          return;
        }

        const latVal = parseFloat(document.getElementById('regLat').value);
        const lngVal = parseFloat(document.getElementById('regLng').value);

        if (isNaN(latVal) || isNaN(lngVal)) {
          alert("Por favor selecciona tu ubicación en el mapa o usa el botón de GPS.");
          return;
        }

        const submitBtn = document.getElementById('submitBtn');
        submitBtn.innerText = "Guardando en Supabase...";
        submitBtn.disabled = true;

        const payload = {
          title: document.getElementById('regTitle').value,
          category: document.getElementById('regCategory').value,
          sector: document.getElementById('regSector').value,
          description: document.getElementById('regDesc').value,
          phone: document.getElementById('regPhone').value,
          lat: latVal,
          lng: lngVal
        };

        try {
          const { createClient } = await import('https://cdn.jsdelivr.net/npm/@supabase/supabase-js/+esm');
          const supabaseClient = createClient(supabaseUrl, supabaseAnonKey);

          const { data, error } = await supabaseClient.from('providers').insert([payload]).select();

          if (error) throw error;

          alert('¡Tu servicio ha sido registrado exitosamente en RedRural!');
          window.location.reload();
        } catch (err) {
          alert('Ocurrió un error al guardar en la base de datos: ' + err.message);
          submitBtn.innerText = "Guardar en el Mapa";
          submitBtn.disabled = false;
        }
      });
    }
  });
</script>

<style>
	:global(body) {
		margin: 0;
		font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
		background-color: #faf9f5;
		color: #2d3748;
	}

	.app-container {
		display: flex;
		height: 100vh;
		width: 100vw;
		overflow: hidden;
	}

	.sidebar {
		width: 380px;
		background-color: #ffffff;
		border-right: 1px solid #e2e8f0;
		display: flex;
		flex-direction: column;
		padding: 1.5rem;
		box-sizing: border-box;
		gap: 1.2rem;
		z-index: 1000;
		box-shadow: 4px 0 15px rgba(27, 67, 50, 0.05);
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.logo-icon {
		font-size: 2rem;
		background: #e8f5e9;
		padding: 0.4rem;
		border-radius: 12px;
	}

	.header h1 {
		margin: 0;
		font-size: 1.4rem;
		color: #1b4332;
		font-weight: 700;
	}

	.header p {
		margin: 0.2rem 0 0 0;
		font-size: 0.85rem;
		color: #52796f;
	}

	.search-box input {
		width: 100%;
		padding: 0.75rem 1rem;
		border: 1.5px solid #d8f3dc;
		border-radius: 10px;
		font-size: 0.9rem;
		box-sizing: border-box;
		outline: none;
		background-color: #faf9f5;
	}

	.categories {
		display: flex;
		gap: 0.5rem;
		overflow-x: auto;
		padding-bottom: 0.3rem;
	}

	.chip {
		background: #f0fdf4;
		border: 1px solid #d8f3dc;
		color: #2d6a4f;
		padding: 0.4rem 0.8rem;
		border-radius: 20px;
		font-size: 0.8rem;
		font-weight: 600;
		cursor: pointer;
		white-space: nowrap;
	}

	.chip.active {
		background: #2d6a4f;
		color: white;
	}

	.services-list {
		flex: 1;
		overflow-y: auto;
		display: flex;
		flex-direction: column;
		gap: 0.8rem;
	}

	.card {
		display: flex;
		gap: 0.8rem;
		padding: 0.9rem;
		border: 1px solid #e2e8f0;
		border-radius: 12px;
		background-color: #ffffff;
		cursor: pointer;
	}

	.card-icon {
		font-size: 1.6rem;
		background: #f0fdf4;
		width: 42px;
		height: 42px;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 10px;
		flex-shrink: 0;
	}

	.card h3 {
		margin: 0;
		font-size: 0.95rem;
		color: #1b4332;
	}

	.card p {
		margin: 0.2rem 0 0.4rem 0;
		font-size: 0.8rem;
		color: #4a5568;
	}

	.sector {
		font-size: 0.75rem;
		color: #2d6a4f;
		font-weight: 600;
	}

	.btn-publish {
		background-color: #1b4332;
		color: white;
		border: none;
		padding: 0.9rem;
		border-radius: 10px;
		font-weight: 700;
		cursor: pointer;
	}

	.map-container {
		flex: 1;
		height: 100%;
	}

	#map {
		width: 100%;
		height: 100%;
	}

	.modal-overlay {
		position: fixed;
		top: 0;
		left: 0;
		width: 100vw;
		height: 100vh;
		background: rgba(27, 67, 50, 0.4);
		backdrop-filter: blur(4px);
		display: none;
		justify-content: center;
		align-items: center;
		z-index: 2000;
	}

	.modal-overlay.active {
		display: flex;
	}

	.modal-content {
		background: #ffffff;
		padding: 1.8rem;
		border-radius: 16px;
		width: 90%;
		max-width: 440px;
		max-height: 90vh;
		overflow-y: auto;
	}

	.modal-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 1rem;
	}

	.close-btn {
		background: none;
		border: none;
		font-size: 1.5rem;
		cursor: pointer;
	}

	.register-form {
		display: flex;
		flex-direction: column;
		gap: 0.8rem;
	}

	.register-form label {
		display: flex;
		flex-direction: column;
		font-size: 0.8rem;
		font-weight: 600;
		color: #2d3748;
		gap: 0.3rem;
	}

	.register-form input, .register-form select, .register-form textarea {
		padding: 0.6rem;
		border: 1px solid #cbd5e0;
		border-radius: 8px;
		font-size: 0.85rem;
	}

	.btn-gps {
		background: #e8f5e9;
		color: #1b4332;
		border: 1px solid #b7e4c7;
		padding: 0.5rem;
		border-radius: 6px;
		font-weight: 600;
		font-size: 0.8rem;
		cursor: pointer;
		margin-bottom: 0.4rem;
	}

	.coords-info {
		background: #f0fdf4;
		padding: 0.75rem;
		border-radius: 8px;
		border: 1px solid #b7e4c7;
		font-size: 0.75rem;
	}

	.coords-fields {
		display: flex;
		gap: 0.5rem;
	}

	.coords-fields input {
		width: 50%;
		background: #e2e8f0;
	}

	.consent-label {
		flex-direction: row !important;
		align-items: flex-start;
		gap: 0.5rem !important;
		font-weight: normal !important;
		font-size: 0.75rem !important;
		color: #4a5568 !important;
	}

	.consent-label input {
		margin-top: 0.1rem;
	}

	.btn-submit {
		background: #2d6a4f;
		color: white;
		border: none;
		padding: 0.85rem;
		border-radius: 8px;
		font-weight: 700;
		cursor: pointer;
	}

	@media (max-width: 768px) {
		.app-container {
			flex-direction: column-reverse;
		}
		.sidebar {
			width: 100%;
			height: 55vh;
		}
		.map-container {
			height: 45vh;
		}
	}
</style>