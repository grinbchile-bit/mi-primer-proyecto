---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Red de Servicios y Turismo Rural">
	<!-- Hojas de estilo de Leaflet para el mapa -->
	<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

	<div class="app-container">
		<!-- Panel Lateral de Servicios -->
		<aside class="sidebar">
			<header class="header">
				<h1>📍 CampoConecta</h1>
				<p>Servicios y Turismo Rural</p>
			</header>

			<div class="search-box">
				<input type="text" id="searchInput" placeholder="¿Qué servicio buscas? (ej. Carpintero, Miel)..." />
			</div>

			<div class="categories">
				<button class="chip active">Todos</button>
				<button class="chip">🪚 Oficios</button>
				<button class="chip">🍯 Productos</button>
				<button class="chip">🥾 Turismo</button>
			</div>

			<div class="services-list">
				<div class="card" onclick="centerMap(-41.4717, -72.9365, 'Don Pedro - Carpintería')">
					<span class="icon">🪚</span>
					<div class="info">
						<h3>Don Pedro - Carpintería</h3>
						<p>Trabajos en madera, cercos y estructuras.</p>
						<span class="distance">📍 Sector Cruce Los Arrayanes</span>
					</div>
				</div>

				<div class="card" onclick="centerMap(-41.4800, -72.9500, 'Apicultura El Roble')">
					<span class="icon">🍯</span>
					<div class="info">
						<h3>Apicultura El Roble</h3>
						<p>Venta de miel pura de ulmo y polen fresco.</p>
						<span class="distance">📍 Parcela 12</span>
					</div>
				</div>

				<div class="card" onclick="centerMap(-41.4600, -72.9200, 'Senderos y Guiado Local')">
					<span class="icon">🥾</span>
					<div class="info">
						<h3>Senderos y Guiado Local</h3>
						<p>Rutas de trekking por el bosque nativo.</p>
						<span class="distance">📍 Río San Pedro</span>
					</div>
				</div>
			</div>

			<button class="btn-publish">+ Registrar mi Habilidad o Servicio</button>
		</aside>

		<!-- Área Principal del Mapa -->
		<main class="map-container">
			<div id="map"></div>
		</main>
	</div>
</Layout>

<!-- Scripts para inicializar Leaflet.js -->
<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script is:inline>
	// Coordenadas iniciales (Centro de la zona rural de prueba)
	const initialLat = -41.4717;
	const initialLng = -72.9365;

	// Inicializar el mapa
	const map = L.map('map').setView([initialLat, initialLng], 12);

	// Capa del mapa estandar desde OpenStreetMap (Ligera para conexiones 3G/4G)
	L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
		maxZoom: 18,
		attribution: '© OpenStreetMap'
	}).addTo(map);

	// Marcadores de prueba
	const providers = [
		{ lat: -41.4717, lng: -72.9365, title: "🪚 Don Pedro - Carpintería", desc: "Especialista en madera y cercos" },
		{ lat: -41.4800, lng: -72.9500, title: "🍯 Apicultura El Roble", desc: "Miel pura y polen" },
		{ lat: -41.4600, lng: -72.9200, title: "🥾 Senderos y Guiado Local", desc: "Trekking y miradores" }
	];

	// Agregar pines al mapa
	providers.forEach(p => {
		L.marker([p.lat, p.lng])
			.addTo(map)
			.bindPopup(`<b>${p.title}</b><br>${p.desc}`);
	});

	// Función para centrar el mapa al hacer clic en una tarjeta de la lista
	window.centerMap = function(lat, lng, title) {
		map.flyTo([lat, lng], 15, { duration: 1.5 });
	};
</script>

<style>
	:global(body) {
		margin: 0;
		font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
		background-color: #f3f4f6;
	}

	.app-container {
		display: flex;
		height: 100vh;
		width: 100vw;
		overflow: hidden;
	}

	.sidebar {
		width: 380px;
		background-color: #ffffff;
		border-right: 1px solid #e5e7eb;
		display: flex;
		flex-direction: column;
		padding: 1.5rem;
		box-sizing: border-box;
		gap: 1.2rem;
		z-index: 1000;
		box-shadow: 2px 0 10px rgba(0,0,0,0.05);
	}

	.header h1 {
		margin: 0;
		font-size: 1.5rem;
		color: #111827;
	}

	.header p {
		margin: 0.2rem 0 0 0;
		font-size: 0.875rem;
		color: #6b7280;
	}

	.search-box input {
		width: 100%;
		padding: 0.75rem;
		border: 1px solid #d1d5db;
		border-radius: 8px;
		font-size: 0.9rem;
		box-sizing: border-box;
		outline: none;
	}

	.categories {
		display: flex;
		gap: 0.5rem;
		overflow-x: auto;
		padding-bottom: 0.3rem;
	}

	.chip {
		background: #f3f4f6;
		border: none;
		padding: 0.4rem 0.8rem;
		border-radius: 20px;
		font-size: 0.8rem;
		cursor: pointer;
		white-space: nowrap;
	}

	.chip.active {
		background: #15803d;
		color: white;
	}

	.services-list {
		flex: 1;
		overflow-y: auto;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.card {
		display: flex;
		gap: 1rem;
		padding: 1rem;
		border: 1px solid #e5e7eb;
		border-radius: 10px;
		background-color: #fafafa;
		cursor: pointer;
		transition: all 0.2s ease;
	}

	.card:hover {
		background-color: #f0fdf4;
		border-color: #bbf7d0;
		transform: translateY(-2px);
	}

	.card .icon {
		font-size: 1.8rem;
	}

	.card h3 {
		margin: 0;
		font-size: 0.95rem;
		color: #1f2937;
	}

	.card p {
		margin: 0.3rem 0;
		font-size: 0.8rem;
		color: #4b5563;
	}

	.distance {
		font-size: 0.75rem;
		color: #15803d;
		font-weight: 600;
	}

	.btn-publish {
		background-color: #15803d;
		color: white;
		border: none;
		padding: 0.8rem;
		border-radius: 8px;
		font-weight: bold;
		cursor: pointer;
	}

	.map-container {
		flex: 1;
		height: 100%;
		position: relative;
	}

	#map {
		width: 100%;
		height: 100%;
	}

	@media (max-width: 768px) {
		.app-container {
			flex-direction: column-reverse;
		}
		.sidebar {
			width: 100%;
			height: 50vh;
		}
		.map-container {
			height: 50vh;
		}
	}
</style>